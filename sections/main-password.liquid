<div class="password-page">
  <div class="password-page__inner">
    {%- if settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 360 }}" alt="{{ shop.name | escape }}" width="180" class="password-page__logo">
    {%- else -%}
      <h1 class="password-page__logo-text">{{ shop.name }}</h1>
    {%- endif -%}

    <p class="password-page__tagline">{{ section.settings.tagline }}</p>

    {%- form 'storefront_password', class: 'password-page__form' -%}
      {%- if form.errors -%}
        <p class="password-page__error">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>
      {%- endif -%}
      <div class="password-page__field">
        <input type="password" name="password" placeholder="{{ section.settings.placeholder }}" required class="password-page__input" aria-label="Password">
        <button type="submit" class="button button--primary">{{ section.settings.button_label }}</button>
      </div>
    {%- endform -%}

    <p class="password-page__footer">{{ section.settings.footer_text }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Something great is coming. Enter the password to take a look." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter store password" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter" },
    { "type": "text", "id": "footer_text", "label": "Footer text", "default": "Are you the store owner? Log in to your Shopify admin." }
  ]
}
{% endschema %}
