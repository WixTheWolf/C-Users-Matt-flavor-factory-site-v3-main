<div class="testimonials section-padding" style="background: {{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.subheading != blank -%}
        <p class="section-header__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="testimonials__grid" style="--columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <div class="testimonial__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                <span class="testimonial__star {% if i > block.settings.rating %}is-empty{% endif %}">&#9733;</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
          <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
          <figcaption class="testimonial__author">
            {%- if block.settings.author != blank -%}<span class="testimonial__name">{{ block.settings.author }}</span>{%- endif -%}
            {%- if block.settings.detail != blank -%}<span class="testimonial__detail">{{ block.settings.detail }}</span>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Loved by golfers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F4F2ED" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "label": "Star rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Best golf gear I've bought online. Fast shipping and the quality is top notch." },
        { "type": "text", "id": "author", "label": "Author", "default": "Jordan M." },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Verified buyer" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "quote": "Dialed in my whole bag here. Prices beat the pro shop every time.", "author": "Casey R." } },
        { "type": "testimonial", "settings": { "quote": "Customer service actually knows golf. Helped me pick the right shafts.", "author": "Sam T." } }
      ]
    }
  ]
}
{% endschema %}
