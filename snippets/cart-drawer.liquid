{%- comment -%} Slide-out cart drawer (used when cart_type == 'drawer') {%- endcomment -%}
<div class="cart-drawer" data-cart-drawer hidden>
  <div class="cart-drawer__overlay" data-cart-close></div>
  <aside class="cart-drawer__panel" aria-label="{{ 'sections.cart.title' | t }}">
    <header class="cart-drawer__header">
      <h2 class="cart-drawer__title">{{ 'sections.cart.title' | t }}</h2>
      <button class="cart-drawer__close" data-cart-close aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </header>

    <div class="cart-drawer__body" data-cart-body>
      {%- if cart.item_count > 0 -%}
        <ul class="cart-drawer__items">
          {%- for item in cart.items -%}
            <li class="cart-line" data-cart-line="{{ item.key }}">
              <a href="{{ item.url }}" class="cart-line__media">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80" loading="lazy">
                {%- endif -%}
              </a>
              <div class="cart-line__info">
                <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                {%- unless item.variant.title contains 'Default' -%}
                  <p class="cart-line__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-line__price">{{ item.final_price | money }}</p>
                <div class="cart-line__qty">
                  <button class="qty-btn" data-qty-down data-line-key="{{ item.key }}" aria-label="Decrease quantity">&minus;</button>
                  <input type="number" class="qty-input" value="{{ item.quantity }}" min="0" data-line-key="{{ item.key }}" aria-label="{{ 'products.product.quantity' | t }}">
                  <button class="qty-btn" data-qty-up data-line-key="{{ item.key }}" aria-label="Increase quantity">+</button>
                </div>
              </div>
              <button class="cart-line__remove" data-line-key="{{ item.key }}" data-remove aria-label="{{ 'sections.cart.remove' | t }}">{% render 'icon', name: 'close' %}</button>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="cart-drawer__empty">
          <p>{{ 'sections.cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">{{ 'sections.cart.continue_shopping' | t }}</a>
        </div>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <footer class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span>{{ 'sections.cart.subtotal' | t }}</span>
          <span data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__note">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="button button--primary button--full">{{ 'sections.cart.checkout' | t }}</button>
        </form>
      </footer>
    {%- endif -%}
  </aside>
</div>
