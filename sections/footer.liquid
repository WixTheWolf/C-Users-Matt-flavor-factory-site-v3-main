<footer class="footer">
  <div class="page-width footer__inner">
    <div class="footer__brand">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name | escape }}" width="160" loading="lazy" class="footer__logo">
      {%- else -%}
        <span class="footer__logo-text">{{ shop.name }}</span>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p class="footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
      {% render 'social-icons' %}
    </div>

    <div class="footer__menus">
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="footer__menu" {{ block.shopify_attributes }}>
            <h3 class="footer__menu-title">{{ block.settings.heading }}</h3>
            <ul class="footer__menu-list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="footer__bottom">
    <div class="page-width footer__bottom-inner">
      <p class="footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <span class="footer__payment">Secure checkout powered by Shopify</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Premium golf gear, delivered to your doorstep." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Support" } },
        { "type": "menu", "settings": { "heading": "Company" } }
      ]
    }
  ]
}
{% endschema %}
