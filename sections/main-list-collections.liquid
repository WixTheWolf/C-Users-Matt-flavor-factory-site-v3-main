<div class="list-collections section-padding">
  <div class="page-width">
    <h1 class="list-collections__title">{{ page_title }}</h1>
    <div class="collection-list__grid" style="--columns: 3;">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-card">
          <div class="collection-card__media media--ratio" style="--ratio: 1;">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" loading="lazy" width="400" height="400">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <div class="collection-card__overlay"></div>
          <span class="collection-card__title">{{ collection.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
