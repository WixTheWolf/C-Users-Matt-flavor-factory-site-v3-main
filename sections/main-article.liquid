<article class="article section-padding">
  <div class="page-width page-width--narrow">
    <header class="article__header">
      <p class="article__date">{{ article.published_at | date: '%B %d, %Y' }}</p>
      <h1 class="article__title">{{ article.title }}</h1>
      {%- if article.author != blank -%}<p class="article__author">By {{ article.author }}</p>{%- endif -%}
    </header>
    {%- if article.image -%}
      <div class="article__image media--ratio" style="--ratio: 1.8;">
        <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.image.alt | escape }}" loading="eager" width="800" height="445">
      </div>
    {%- endif -%}
    <div class="article__content rte">{{ article.content }}</div>
    <a href="{{ blog.url }}" class="article__back">&larr; {{ 'blogs.article.back_to_blog' | t: title: blog.title }}</a>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
