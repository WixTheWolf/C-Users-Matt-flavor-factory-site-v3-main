<div class="blog section-padding">
  <div class="page-width">
    <h1 class="blog__title">{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <div class="blog__grid">
        {%- for article in blog.articles -%}
          <article class="article-card">
            <a href="{{ article.url }}" class="article-card__media media--ratio" style="--ratio: 1.6;">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="400" height="250">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </a>
            <div class="article-card__info">
              <p class="article-card__date">{{ article.published_at | date: '%B %d, %Y' }}</p>
              <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
              <a href="{{ article.url }}" class="article-card__link">{{ 'blogs.article.read_more' | t }}</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "settings": []
}
{% endschema %}
