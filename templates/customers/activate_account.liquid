<div class="customer section-padding">
  <div class="page-width page-width--narrow">
    <h1 class="customer__title">Activate your account</h1>
    <p>Create your password to activate your account.</p>
    {%- form 'activate_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="customer__row">
        <label for="ActivatePassword">Password</label>
        <input type="password" id="ActivatePassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="customer__row">
        <label for="ActivatePasswordConfirm">Confirm password</label>
        <input type="password" id="ActivatePasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <div class="customer__actions">
        <button type="submit" name="commit" class="button button--primary">Activate account</button>
        <button type="submit" name="decline" class="button button--outline">Decline invitation</button>
      </div>
    {%- endform -%}
  </div>
</div>
