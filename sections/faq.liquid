<div class="faq section-padding" style="background: {{ section.settings.bg_color }};">
  <div class="page-width page-width--narrow">
    <div class="section-header">
      {%- if section.settings.subheading != blank -%}
        <p class="section-header__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary class="faq__question">
            <span>{{ block.settings.question }}</span>
            {% render 'icon', name: 'chevron' %}
          </summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} FAQPage structured data for rich results {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | json }}
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Support" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders ship within 1-2 business days. Standard delivery arrives in 3-5 business days, with free shipping on orders over $99.</p>" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "What's your return policy?", "answer": "<p>We offer 30-day hassle-free returns on unused items in original packaging.</p>" } },
        { "type": "question", "settings": { "question": "Are your products authentic?", "answer": "<p>Yes — every product is 100% genuine, sourced directly from the brands we carry.</p>" } },
        { "type": "question", "settings": { "question": "Do you offer club fitting advice?", "answer": "<p>Absolutely. Reach out through our contact page and our team will help you dial in the right gear.</p>" } }
      ]
    }
  ]
}
{% endschema %}
