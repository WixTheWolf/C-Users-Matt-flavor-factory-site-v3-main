<div class="search-page section-padding">
  <div class="page-width">
    <h1 class="search-page__title">{{ 'general.search.search' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" class="search-page__input">
      <button type="submit" class="button button--primary">{{ 'general.search.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      <p class="search-page__count">{{ 'general.search.results_with_count' | t: count: search.results_count }}</p>
      {%- if search.results.size > 0 -%}
        <div class="product-grid" style="--columns: 4;">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item, lazy_load: forloop.index0 %}
            {%- else -%}
              <article class="search-result-card">
                <a href="{{ item.url }}">
                  <h3>{{ item.title }}</h3>
                  {%- if item.content -%}<p>{{ item.content | strip_html | truncatewords: 25 }}</p>{%- endif -%}
                </a>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="search-page__empty">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
