<div class="announcement-bar" style="--bar-bg: {{ section.settings.bg_color }}; --bar-text: {{ section.settings.text_color }};">
  <div class="page-width announcement-bar__inner">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="announcement-bar__text">{{ section.settings.text }}</a>
    {%- else -%}
      <p class="announcement-bar__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $99" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0B3D21" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
