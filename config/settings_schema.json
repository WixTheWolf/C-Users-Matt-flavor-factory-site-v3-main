[
  {
    "name": "theme_info",
    "theme_name": "WYX Golf Supply",
    "theme_version": "1.0.0",
    "theme_author": "WYX Golf Supply",
    "theme_documentation_url": "https://wyxgolfsupply.com",
    "theme_support_url": "https://wyxgolfsupply.com/pages/contact"
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 80,
        "max": 280,
        "step": 10,
        "unit": "px",
        "default": 150
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (32x32 png recommended)"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand colors"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (fairway green)",
        "default": "#14542E"
      },
      {
        "type": "color",
        "id": "color_primary_dark",
        "label": "Primary dark",
        "default": "#0B3D21"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (sand gold)",
        "default": "#C9A86A"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body text",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted surface",
        "default": "#F4F2ED"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "poppins_n6"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "work_sans_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1280
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "label": "Spacing between sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 56
      },
      {
        "type": "select",
        "id": "button_radius",
        "label": "Button corner radius",
        "options": [
          { "value": "0px", "label": "Square" },
          { "value": "6px", "label": "Rounded" },
          { "value": "999px", "label": "Pill" }
        ],
        "default": "999px"
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show product vendor",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_sale_badge",
        "label": "Show sale badge",
        "default": true
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" },
      { "type": "text", "id": "social_x", "label": "X (Twitter) URL" }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Enable order notes",
        "default": true
      },
      {
        "type": "richtext",
        "id": "free_shipping_text",
        "label": "Free shipping bar text",
        "default": "<p>Free shipping on orders over $99</p>"
      }
    ]
  }
]
