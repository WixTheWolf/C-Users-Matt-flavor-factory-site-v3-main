<div
  data-product-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="featured-collection section-padding">
      <div class="page-width">
        <div class="section-header">
          {%- if section.settings.subheading != blank -%}
            <p class="section-header__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section-header__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        <div class="product-grid" style="--columns: {{ section.settings.columns }};">
          {%- for product in recommendations.products -%}
            {% render 'product-card', card_product: product, lazy_load: forloop.index0 %}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "paragraph", "content": "Dynamic recommendations are generated by Shopify and improve over time. Enable under Apps → Search & Discovery." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "You may also like" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete your bag" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
