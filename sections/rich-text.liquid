<div class="rich-text section-padding rich-text--{{ section.settings.text_align }}" style="background: {{ section.settings.bg_color }};">
  <div class="page-width rich-text__inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <p class="rich-text__subheading" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- when 'heading' -%}
          <h2 class="rich-text__heading" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}
          <div class="rich-text__body rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <div class="rich-text__button" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link }}" class="button button--primary">{{ block.settings.label }}</a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    { "type": "subheading", "name": "Subheading", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Our story" }] },
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Built by golfers, for golfers" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>We started WYX Golf Supply to make premium gear accessible without the pro-shop markup. Every product is hand-picked and quality-checked.</p>" }] },
    { "type": "button", "name": "Button", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Learn more" }, { "type": "url", "id": "link", "label": "Link" }] }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        { "type": "subheading" },
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
